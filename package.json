{
  "name": "agrotrack",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace=@agrotrack/web",
    "dev:api": "npm run dev --workspace=@agrotrack/api",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=@agrotrack/web",
    "build:api": "npm run build --workspace=@agrotrack/api",
    "lint": "npm run lint --workspaces --if-present",
    "db:up": "docker compose up -d --wait --wait-timeout 120 db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:status": "docker compose ps",
    "db:check": "npm run db:check --workspace=@agrotrack/api",
    "db:migrate": "npm run db:migrate --workspace=@agrotrack/api",
    "db:migrations": "npm run db:migrations --workspace=@agrotrack/api",
    "db:seed": "npm run db:seed --workspace=@agrotrack/api",
    "prisma:format": "npm run prisma:format --workspace=@agrotrack/api",
    "prisma:generate": "npm run prisma:generate --workspace=@agrotrack/api",
    "prisma:validate": "npm run prisma:validate --workspace=@agrotrack/api",
    "test:api": "npm run test --workspace=@agrotrack/api"
  },
  "overrides": {
    "@prisma/config@7.10.0": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma@7.10.0": {
      "mysql2": "3.24.5"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
