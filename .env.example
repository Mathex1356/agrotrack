# Configuracao exclusivamente local. Copie para .env na raiz.
PORT=3000
NODE_ENV=development
# Gere dois segredos independentes com crypto.randomBytes(32).toString('base64url').
AUTH_JWT_SECRET=SUBSTITUA_POR_SEGREDO_ALEATORIO_BASE64URL
AUTH_RATE_LIMIT_SECRET=SUBSTITUA_POR_OUTRO_SEGREDO_ALEATORIO_BASE64URL
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_ACCESS_TTL_SECONDS=300
AUTH_REFRESH_TTL_SECONDS=604800
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_RATE_WINDOW_SECONDS=900
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_EMAIL_LIMIT=10
AUTH_REFRESH_IP_LIMIT=60
POSTGRES_DB=agrotrack_dev
POSTGRES_USER=agrotrack_local
POSTGRES_PASSWORD=SUBSTITUA_POR_UMA_SENHA_LOCAL
POSTGRES_PORT=5432
# Repita banco, usuario, porta e senha acima. Codifique caracteres especiais na URL.
DATABASE_URL=postgresql://agrotrack_local:SUBSTITUA_POR_UMA_SENHA_LOCAL@127.0.0.1:5432/agrotrack_dev
