generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum OrganizationStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum SystemRoleCode {
  OWNER
  MANAGER
  AGRONOMIST
  WORKER
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

enum PermissionStatus {
  ACTIVE
  INACTIVE
}

enum PermissionScope {
  ORGANIZATION
  FARM
}

enum OrganizationMembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum FarmStatus {
  ACTIVE
  INACTIVE
}

enum FarmMembershipStatus {
  ACTIVE
  REVOKED
}

model User {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  displayName     String
  email           String
  normalizedEmail String                   @unique
  status          UserStatus               @default(ACTIVE)
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                 @default(now()) @updatedAt @db.Timestamptz(3)
  memberships     OrganizationMembership[]
}

model Organization {
  id            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  referenceCode String                   @unique
  status        OrganizationStatus       @default(PROVISIONING)
  createdAt     DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime                 @default(now()) @updatedAt @db.Timestamptz(3)
  roles         Role[]
  memberships   OrganizationMembership[]
  farms         Farm[]
  invitations   Invitation[]
  crops         Crop[]
}

model Role {
  id             String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                   @db.Uuid
  name           String
  systemCode     SystemRoleCode?
  status         RoleStatus               @default(ACTIVE)
  createdAt      DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                 @default(now()) @updatedAt @db.Timestamptz(3)
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permissions    RolePermission[]
  memberships    OrganizationMembership[]
  invitations    Invitation[]

  @@unique([organizationId, id])
  @@unique([organizationId, systemCode])
  @@unique([organizationId, name])
}

model Permission {
  code        String           @id
  description String
  scope       PermissionScope
  status      PermissionStatus @default(ACTIVE)
  roles       RolePermission[]
}

model RolePermission {
  organizationId String     @db.Uuid
  roleId         String     @db.Uuid
  permissionCode String
  role           Role       @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict, onUpdate: Restrict)

  @@id([roleId, permissionCode])
  @@index([organizationId, roleId])
  @@index([permissionCode])
}

model OrganizationMembership {
  id                  String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String                       @db.Uuid
  userId              String                       @db.Uuid
  roleId              String                       @db.Uuid
  status              OrganizationMembershipStatus @default(ACTIVE)
  joinedAt            DateTime                     @default(now()) @db.Timestamptz(3)
  revokedAt           DateTime?                    @db.Timestamptz(3)
  createdAt           DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                     @default(now()) @updatedAt @db.Timestamptz(3)
  organization        Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user                User                         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role                Role                         @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  farms               FarmMembership[]
  sentInvitations     Invitation[]                 @relation("Inviter")
  acceptedInvitations Invitation[]                 @relation("Acceptor")

  @@unique([organizationId, id])
  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, roleId, status])
}

model Farm {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String           @db.Uuid
  code             String
  name             String
  legalOwnerName   String?
  locationText     String?
  municipality     String
  state            String
  country          String
  timezone         String
  totalAreaHa      Decimal          @db.Decimal(18, 6)
  productiveAreaHa Decimal          @db.Decimal(18, 6)
  description      String?
  status           FarmStatus       @default(ACTIVE)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @default(now()) @updatedAt @db.Timestamptz(3)
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  memberships      FarmMembership[]
  invitations      InvitationFarm[]
  fields           Field[]
  seasons          Season[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId, status])
}

model FarmMembership {
  id                       String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId           String                 @db.Uuid
  organizationMembershipId String                 @db.Uuid
  farmId                   String                 @db.Uuid
  status                   FarmMembershipStatus   @default(ACTIVE)
  revokedAt                DateTime?              @db.Timestamptz(3)
  createdAt                DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime               @default(now()) @updatedAt @db.Timestamptz(3)
  membership               OrganizationMembership @relation(fields: [organizationId, organizationMembershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  farm                     Farm                   @relation(fields: [organizationId, farmId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, organizationMembershipId, farmId], map: "FarmMembership_member_farm_key")
  @@index([organizationId, farmId, status])
}

model Invitation {
  id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String                  @db.Uuid
  normalizedEmail      String
  roleId               String                  @db.Uuid
  inviterMembershipId  String?                 @db.Uuid
  tokenDigest          String                  @unique
  expiresAt            DateTime                @db.Timestamptz(3)
  acceptedAt           DateTime?               @db.Timestamptz(3)
  revokedAt            DateTime?               @db.Timestamptz(3)
  acceptedMembershipId String?                 @db.Uuid
  createdAt            DateTime                @default(now()) @db.Timestamptz(3)
  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role                 Role                    @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  inviter              OrganizationMembership? @relation("Inviter", fields: [organizationId, inviterMembershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  acceptedMembership   OrganizationMembership? @relation("Acceptor", fields: [organizationId, acceptedMembershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  farms                InvitationFarm[]

  @@unique([organizationId, id])
  @@index([organizationId, normalizedEmail])
  @@index([organizationId, roleId])
  @@index([organizationId, inviterMembershipId])
  @@index([organizationId, acceptedMembershipId])
  @@index([expiresAt])
}

model InvitationFarm {
  organizationId String     @db.Uuid
  invitationId   String     @db.Uuid
  farmId         String     @db.Uuid
  invitation     Invitation @relation(fields: [organizationId, invitationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  farm           Farm       @relation(fields: [organizationId, farmId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([invitationId, farmId])
  @@index([organizationId, invitationId])
  @@index([organizationId, farmId])
}

enum FieldStatus {
  ACTIVE
  INACTIVE
}

enum CropScope {
  GLOBAL
  ORGANIZATION
}

enum CropStatus {
  ACTIVE
  INACTIVE
}

enum SeasonStatus {
  PLANNED
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum PlantingStatus {
  PLANNED
  IN_PROGRESS
  FINISHED
  CANCELLED
}

model Field {
  id               String                                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String                                      @db.Uuid
  farmId           String                                      @db.Uuid
  code             String
  name             String
  areaHa           Decimal                                     @db.Decimal(18, 6)
  soilType         String?
  description      String?
  notes            String?
  status           FieldStatus                                 @default(ACTIVE)
  boundary         Unsupported("geometry(MultiPolygon,4326)")?
  geometryRevision Int                                         @default(0)
  createdAt        DateTime                                    @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                                    @default(now()) @updatedAt @db.Timestamptz(3)
  farm             Farm                                        @relation(fields: [organizationId, farmId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  plantings        Planting[]

  @@unique([organizationId, farmId, id])
  @@unique([organizationId, farmId, code])
  @@index([organizationId, farmId, status])
}

model Crop {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope          CropScope
  organizationId String?       @db.Uuid
  code           String
  name           String
  status         CropStatus    @default(ACTIVE)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  plantings      Planting[]

  // SQL adds a partial unique index for GLOBAL codes (organizationId IS NULL).
  @@unique([organizationId, code])
  @@index([scope, organizationId, status])
}

model Season {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String       @db.Uuid
  farmId          String       @db.Uuid
  code            String
  name            String
  startDate       DateTime     @db.Date
  expectedEndDate DateTime     @db.Date
  actualEndDate   DateTime?    @db.Date
  status          SeasonStatus @default(PLANNED)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  farm            Farm         @relation(fields: [organizationId, farmId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  plantings       Planting[]

  @@unique([organizationId, farmId, id])
  @@unique([organizationId, farmId, code])
  @@index([organizationId, farmId, status])
}

model Planting {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String         @db.Uuid
  farmId           String         @db.Uuid
  seasonId         String         @db.Uuid
  fieldId          String         @db.Uuid
  cropId           String         @db.Uuid
  variety          String?
  plannedAreaHa    Decimal        @db.Decimal(18, 6)
  actualAreaHa     Decimal?       @db.Decimal(18, 6)
  plannedStartDate DateTime       @db.Date
  expectedEndDate  DateTime?      @db.Date
  actualStartDate  DateTime?      @db.Date
  actualEndDate    DateTime?      @db.Date
  spacingMeters    Decimal?       @db.Decimal(18, 6)
  populationPerHa  Decimal?       @db.Decimal(20, 6)
  notes            String?
  status           PlantingStatus @default(PLANNED)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @default(now()) @updatedAt @db.Timestamptz(3)
  field            Field          @relation(fields: [organizationId, farmId, fieldId], references: [organizationId, farmId, id], onDelete: Restrict, onUpdate: Restrict)
  season           Season         @relation(fields: [organizationId, farmId, seasonId], references: [organizationId, farmId, id], onDelete: Restrict, onUpdate: Restrict)
  crop             Crop           @relation(fields: [cropId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, farmId, fieldId, status])
  @@index([organizationId, farmId, seasonId, status])
  @@index([cropId])
}
