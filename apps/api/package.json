{
  "name": "@agrotrack/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "predev": "npm run prisma:generate",
    "prebuild": "npm run prisma:generate",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint . --max-warnings 0",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "db:migrate": "prisma migrate deploy",
    "db:migrations": "prisma migrate status",
    "db:seed": "npm run build && prisma db seed",
    "prisma:validate": "prisma validate",
    "db:check": "npm run build && node scripts/check-database.mjs",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "prisma": "7.10.0"
  }
}
